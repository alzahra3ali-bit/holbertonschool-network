#!/usr/bin/env bash
# Modifies /etc/hosts so that localhost resolves to 127.0.0.2 and facebook.com resolves to 8.8.8.8
sudo awk '!/\<localhost\>/ && !\<facebook.com\>/' /etc/hosts | sudo tee /etc/hosts.new > /dev/null
echo '127.0.0.2 localhost' | sudo tee -a /etc/hosts.new > /dev/null
echo '8.8.8.8 facebook.com' | sudo tee -a /etc/hosts.new > /dev/null
sudo mv /etc/hosts.new /etc/hosts
